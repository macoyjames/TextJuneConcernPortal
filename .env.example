# --- Database (Vercel Postgres / Neon) ---
# In Vercel: Storage tab -> Create Database -> Postgres (Neon). Copy the "POSTGRES_PRISMA_URL"
# (pooled, used at runtime) and "POSTGRES_URL_NON_POOLING" (direct, used for migrations).
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgres://user:password@host/dbname?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# In production this should be your deployed URL, e.g. https://concerns.textjune.com
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Vercel Blob (file uploads) ---
# In Vercel: Storage tab -> Create Database -> Blob. Copy the token.
BLOB_READ_WRITE_TOKEN=""

# --- Resend (email notifications) ---
# https://resend.com -> API Keys
RESEND_API_KEY=""
# Must be a domain/sender verified in Resend, e.g. "TextJune Concern Portal <concerns@textjune.com>"
EMAIL_FROM="TextJune Concern Portal <onboarding@resend.dev>"

# --- App ---
# Comma-separated list of emails allowed to manage the Manager list at /admin/managers
SUPER_ADMIN_EMAILS="you@company.com"
